NODE_ENV=development
APP_URL=http://localhost:3000
# Where the Next server reaches the API directly, server-to-server.
# The browser never uses this — it calls /api on the web origin, which Next proxies.
API_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://tweetbrainam:tweetbrainam@localhost:5433/tweetbrainam
REDIS_URL=redis://localhost:6379

X_CLIENT_ID=
X_CLIENT_SECRET=
# Must point at the WEB origin, not the API — the browser reaches the API through
# Next's /api proxy so the session cookie lands on the same origin the app runs on.
X_REDIRECT_URI=http://localhost:3000/api/v1/auth/x/callback

GROQ_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
AI_FAILOVER_ORDER=groq,grok,openai

# Embeddings pick draft examples by meaning instead of by keyword.
# COHERE_API_KEY wins if both are set (embed-v4.0, free trial tier).
# OPENAI_API_KEY is the fallback (text-embedding-3-small).
# Both output 1536 dimensions, so you can switch without re-embedding.
# With neither, drafts still get real example posts — chosen by keyword and
# recency rather than similarity. Nothing breaks; retrieval is just blunter.
COHERE_API_KEY=

TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Web Push. Generate with: npx web-push generate-vapid-keys
# The public key must also reach the browser, hence the NEXT_PUBLIC_ twin.
# VAPID_SUBJECT must be a mailto: or https: URL you control.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

TRIGGER_SECRET_KEY=

PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

SENTRY_DSN=
